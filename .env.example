############################################################
# JARVIS — environment configuration (copy to .env)
# Local-first defaults: works with NO paid API keys.
############################################################

# --- app ---
APP_NAME=JARVIS
ENVIRONMENT=local
DEBUG=true
SECRET_KEY=change-me-in-production

# --- API auth + CORS (ENABLE BEFORE EXPOSING BEYOND LOCALHOST) ---
# Auth is enforced when API_AUTH_ENABLED=true OR API_TOKEN is set. Without it,
# anyone who can reach the port can control your PC/accounts. Generate a token:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_AUTH_ENABLED=false
API_TOKEN=
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- database / infra ---
# Local default is SQLite (no service needed). For Docker Compose / scale-up:
# DATABASE_URL=postgresql+psycopg://jarvis:jarvis@postgres:5432/jarvis
# DATABASE_URL=sqlite:///./data/jarvis.db
REDIS_URL=redis://localhost:6379/0

# --- security: workspace + allowlists ---
# Tools may only touch these roots. Add comma-separated extra absolute paths.
ALLOWED_PATHS=
# Browser/network tools may only reach these domains (comma-separated).
ALLOWED_DOMAINS=example.com,localhost
# Read-only terminal allowlist / destructive blocklist.
COMMAND_ALLOWLIST=ls,cat,echo,pwd,whoami,date,uptime,df,free
COMMAND_BLOCKLIST=rm -rf,mkfs,format,shutdown,reboot,dd if=,reg delete,netsh,iptables

# --- policy toggles ---
ALLOW_LOW_RISK_WRITE=true
TRUSTED_TERMINAL_READ=false
ALLOW_NETWORK=true
DEFAULT_MODE=SINGLE_BEST_MODEL

# --- local LLM (default provider) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1

# --- optional cloud providers (leave blank to stay fully local) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

# --- RAG / memory ---
# memory       = dependency-free lexical retriever (default)
# local_vector = offline hashing embeddings + cosine index (no service/model)
# chroma       = Chroma (pip install chromadb)
# qdrant       = Qdrant (pip install qdrant-client + a running Qdrant)
VECTOR_BACKEND=memory
QDRANT_URL=http://localhost:6333

# --- Telegram (primary chat; disabled until configured) ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# --- Voice (Phase 2) ---
VOICE_ENABLED=false
STT_ENGINE=faster-whisper
STT_MODEL=base
TTS_ENGINE=piper
PIPER_VOICE=en_US-amy-medium

# --- Browser ---
BROWSER_HEADLESS=false

# --- Workflow scheduler (cron-driven background loop; off by default) ---
SCHEDULER_ENABLED=false
